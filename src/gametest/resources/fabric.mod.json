{
  "schemaVersion": 1,
  "id": "pet_recall_gametest",
  "version": "1.0.0",
  "name": "NoLostPets Game Tests",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.creas.petrecall.gametest.PetRecallGameTestBootstrap"
    ],
    "fabric-gametest": [
      "com.creas.petrecall.gametest.PetRecallGameTests",
      "com.creas.petrecall.gametest.PetRecallBehaviorGameTests",
      "com.creas.petrecall.gametest.AutoRecallBatchGameTests",
      "com.creas.petrecall.gametest.PetRecallRuntimeGameTests"
    ],
    "fabric-client-gametest": [
      "com.creas.petrecall.gametest.PetRecallClientGameTests"
    ]
  },
  "mixins": [
    "pet_recall_gametest.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-gametest-api-v1": "*",
    "minecraft": "*",
    "java": ">=21",
    "pet_recall": "*"
  }
}
