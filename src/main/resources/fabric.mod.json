{
  "schemaVersion": 1,
  "id": "pet_recall",
  "version": "${version}",
  "name": "NoLostPets",
  "description": "Bring companion pets back to their owner with temporary source chunk loading and safe teleport positions. Sitting and mounted pets stay in place.",
  "authors": [
    "Zlo"
  ],
  "contact": {},
  "license": "GPL-3.0-only",
  "icon": "assets/pet_recall/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.creas.petrecall.PetRecallMod"
    ],
    "client": [
      "com.creas.petrecall.smoke.LanSmokeClient"
    ]
  },
  "mixins": [
    "pet-recall.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
